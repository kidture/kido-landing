# Copy to .env.local and fill in your Google Apps Script Web App URL
# See docs/superpowers/plans/2026-05-01-kido-landing-page.md for setup instructions
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# A separate Google Apps Script webhook for Android beta requests.
# Keep this server-side variable in Vercel; do not prefix it with NEXT_PUBLIC_.
BETA_REQUEST_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_BETA_SCRIPT_ID/exec

# Public TestFlight invitation URL. This is safe to expose to iPhone and iPad visitors.
PUBLIC_TESTFLIGHT_BETA_URL=https://testflight.apple.com/join/YOUR_CODE
