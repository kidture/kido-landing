# Copy to .env.local and fill in your Google Apps Script Web App URL
# See docs/superpowers/plans/2026-05-01-kido-landing-page.md for setup instructions
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# A separate Google Apps Script webhook for Android beta requests.
# Keep this server-side variable in Vercel; do not prefix it with NEXT_PUBLIC_.
BETA_REQUEST_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_BETA_SCRIPT_ID/exec

# Same Apps Script /exec URL and script-property token, used only by /admin server routes.
BETA_ADMIN_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_BETA_SCRIPT_ID/exec
BETA_ADMIN_WEBHOOK_TOKEN=replace-with-the-Apps-Script-property-value

# One private beta-operations login. Keep all of these values server-only.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-a-different-long-random-secret

# Dashboard email delivery. The Android Play link must never be NEXT_PUBLIC_.
RESEND_API_KEY=re_replace_me
MAIL_FROM=Kidture <noreply@kidture.health>
BETA_PLAY_OPT_IN_URL=https://play.google.com/apps/testing/YOUR_APP_ID

# Public TestFlight invitation URL. This is safe to expose to iPhone and iPad visitors.
PUBLIC_TESTFLIGHT_BETA_URL=https://testflight.apple.com/join/YOUR_CODE
